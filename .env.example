# Create a bot with @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=

# MongoDB Atlas or another MongoDB deployment URI.
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=telegram_market_alerts
# Optional: use this if the local DNS refuses MongoDB SRV queries.
# MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8

# Optional TradingView account cookies. Anonymous data may be delayed or limited.
# Keep these values secret and never commit them.
TRADINGVIEW_SESSION=
TRADINGVIEW_SIGNATURE=

# Set to true to show debug logs from the market-data adapter.
TRADINGVIEW_DEBUG=false

# Log verbosity: debug, info, warn or error.
LOG_LEVEL=info
