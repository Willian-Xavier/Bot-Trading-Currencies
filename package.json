{
  "name": "telegram-market-alerts",
  "version": "1.0.0",
  "private": true,
  "description": "Telegram bot for real-time stock and foreign-exchange price alerts.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@mathieuc/tradingview": "^4.1.0",
    "dotenv": "^16.5.0",
    "grammy": "^1.38.4",
    "mongodb": "^6.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
